                      disabled={selectedTagType !== "choose-template"}
                      className="relative flex items-center flex-1 mt-[-1.00px] font-input-value font-[number:var(--input-value-font-weight)] text-palette-text-primary text-[length:var(--input-value-font-size)] tracking-[var(--input-value-letter-spacing)] leading-[var(--input-value-line-height)] [font-style:var(--input-value-font-style)] disabled:text-palette-text-primary disabled:opacity-100"
