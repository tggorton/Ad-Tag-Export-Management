                  <span className="relative w-fit mt-[-1.00px] font-typography-body1 font-[number:var(--typography-body1-font-weight)] text-palette-text-primary text-[length:var(--typography-body1-font-size)] tracking-[var(--typography-body1-letter-spacing)] leading-[var(--typography-body1-line-height)] whitespace-nowrap [font-style:var(--typography-body1-font-style)]">
                    Tag Type
                  </span>
                </legend>
                <div className="items-center gap-3 inline-flex relative flex-[0_0_auto]">
                  {tagTypeOptions.map(({ value, label, Icon }) => {
                    const checked = selectedTagType === value;

                    return (
                      <label
                        key={value}
                        className="inline-flex items-center relative flex-[0_0_auto] cursor-pointer"
                      >
                        <input
                          type="radio"
                          name="tagType"
                          value={value}
                          checked={checked}
